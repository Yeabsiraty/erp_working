# ይህን ፋይል ወደ `.env` ገልብጠው ዋጋዎቹን ይሙሉ:  cp .env.example .env
# `.env` ወደ git/ማንም አይላክም (.gitignore ውስጥ አለ)።

# ---- Django ----
# አዲስ ቁልፍ:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_DB_PATH=/var/data/ledger.sqlite3
# FRONTEND_DIST=/srv/ledger/frontend/dist

# ---- የመጀመሪያ አስተዳዳሪ (python manage.py createsuperuser --noinput) ----
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-too

# ---- የሱቅ / ሰነድ መረጃ (መነሻ እሴት፤ በ"ቅንብር" ገጽ ይቀየራል) ----
SHOP_NAME=ABROS ሱቅ
SHOP_TITLE_AM=አብሮስ ህትመት ስራ
SHOP_TITLE_EN=ABROS PRINTING WORK
SHOP_WEBSITE=www.abrosprint.com
